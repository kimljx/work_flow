# Linux offline runtime bootstrap.
# Business settings such as mail, QAX, schedules, and host/IP mappings are stored in PostgreSQL
# and maintained from the System Settings modal.
APP_NAME=Work Flow
APP_ENV=prod
SECRET_KEY=please-change-to-a-random-32-character-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080
DEFAULT_PASSWORD=ChangeMe123

# In Podman offline mode run_project.sh injects this value automatically.
DATABASE_URL=postgresql+psycopg://work_flow:work_flow_change_me@127.0.0.1:15432/work_flow

# System log cleanup is process-level bootstrap config; UI business settings live in DB.
SYSTEM_LOG_RETENTION_DAYS=60
SYSTEM_LOG_CLEANUP_INTERVAL_SECONDS=86400
