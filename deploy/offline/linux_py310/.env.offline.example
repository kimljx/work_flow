# Linux 内网离线发布包环境模板
# 使用方式：首次执行 install_offline.sh 时会自动复制为 app/.env，之后再按实际环境修改。

APP_NAME=工作流管理系统
APP_ENV=prod
SECRET_KEY=请替换为至少32位随机字符串
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080
DATABASE_URL=sqlite:///./backend/data/app.db
DEFAULT_PASSWORD=ChangeMe123

# QAX 配置
QAX_BASE_URL=
QAX_USERNAME=
QAX_PASSWORD=
QAX_GROUP_NAME=普通分组
QAX_BROWSER_HEADLESS=true
QAX_IGNORE_HTTPS_ERRORS=true
QAX_COLLECT_CRON=0 * * * *

# 提醒与系统日志
REMIND_DAILY_RUN_AT=09:00
SYSTEM_LOG_RETENTION_DAYS=60
SYSTEM_LOG_CLEANUP_INTERVAL_SECONDS=86400

# 邮件收发
MAIL_AUTO_POLL_ENABLED=false
MAIL_AUTO_POLL_INTERVAL_SECONDS=300
MAIL_INBOX_PROTOCOL=imap
MAIL_INBOX_MAX_SCAN=20
IMAP_MAX_UNSEEN_SCAN=20

SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_TLS=false
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20

# 可选：不修改服务器 DNS 时，在应用内把邮件域名映射到 IP。
# 写法一：MAIL_HOST_IP_MAP={"smtp.example.internal":"10.0.0.10","pop3.example.internal":"10.0.0.11"}
# 写法二：复制 config/mail-hosts.example.json 为 config/mail-hosts.json 后修改。
MAIL_HOST_IP_MAP=

IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_USE_TLS=false
IMAP_USE_SSL=true

POP3_HOST=
POP3_PORT=110
POP3_USER=
POP3_PASSWORD=
POP3_USE_TLS=false
POP3_USE_SSL=false
