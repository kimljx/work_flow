FROM mcr.microsoft.com/playwright/python:v1.52.0-jammy

COPY backend/requirements.txt /tmp/work-flow-requirements.txt
RUN python3 -m pip install --no-cache-dir -r /tmp/work-flow-requirements.txt

COPY deploy/offline/podman_rhel7_offline/container/start-work-flow-container.sh /usr/local/bin/start-work-flow-container
RUN chmod +x /usr/local/bin/start-work-flow-container

ENV APP_PORT=18849 \
    PYTHONUTF8=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PLAYWRIGHT_SKIP_BROWSER_GC=1

EXPOSE 18849
WORKDIR /opt/work_flow
CMD ["bash", "/usr/local/bin/start-work-flow-container"]
