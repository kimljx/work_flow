# 内网离线发布包环境模板
# 使用方式：首次启动时会自动复制为 app\.env，之后再按实际环境修改。

APP_NAME=工作流管理系统
APP_ENV=prod
SECRET_KEY=请替换为至少32位随机字符串
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080
DATABASE_URL=sqlite:///./backend/data/app.db
DEFAULT_PASSWORD=ChangeMe123

# QAX 配置
QAX_BASE_URL=
QAX_USERNAME=
QAX_PASSWORD=
QAX_GROUP_NAME=普通分组
QAX_BROWSER_HEADLESS=true
QAX_IGNORE_HTTPS_ERRORS=true
QAX_COLLECT_CRON=0 * * * *

# 提醒与系统日志
REMIND_DAILY_RUN_AT=09:00
SYSTEM_LOG_RETENTION_DAYS=60
SYSTEM_LOG_CLEANUP_INTERVAL_SECONDS=86400

# 内网部署建议默认关闭自动收件，待邮件配置完成后再开启
MAIL_AUTO_POLL_ENABLED=false
MAIL_AUTO_POLL_INTERVAL_SECONDS=300
MAIL_INBOX_PROTOCOL=imap
MAIL_INBOX_MAX_SCAN=20
IMAP_MAX_UNSEEN_SCAN=20

# SMTP 发信配置
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_TLS=false
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20

# SMTP 提示：
# 1. 465 端口通常使用 SMTP_USE_SSL=true 且 SMTP_USE_TLS=false。
# 2. 587 端口通常使用 SMTP_USE_TLS=true 且 SMTP_USE_SSL=false。
# 3. SMTP_USE_SSL 与 SMTP_USE_TLS 不要同时为 true。
MAIL_HOST_IP_MAP=
# 可选：不修改服务器 DNS 时，在应用内把邮件域名映射到 IP。
# 示例：MAIL_HOST_IP_MAP={"smtp.example.internal":"10.0.0.10","pop3.example.internal":"10.0.0.11"}
# 也可以复制 config/mail-hosts.example.json 为 config/mail-hosts.json 后修改。

# IMAP 收件配置
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_USE_TLS=false
IMAP_USE_SSL=true

# POP3 收件配置
POP3_HOST=
POP3_PORT=110
POP3_USER=
POP3_PASSWORD=
POP3_USE_TLS=false
POP3_USE_SSL=false

# 收件协议提示：
# 1. MAIL_INBOX_PROTOCOL 可选 imap 或 pop3。
# 2. 993 端口通常使用 IMAP_USE_SSL=true 且 IMAP_USE_TLS=false。
# 3. 995 端口通常使用 POP3_USE_SSL=true 且 POP3_USE_TLS=false。
# 4. 收件协议的 SSL 与 TLS 开关不要同时为 true。
